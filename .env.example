# Environment configuration for LLMForge Lab

# Intelligence API Settings
GEMINI_API_KEY=your_gemini_api_key_here
LLMFORGE_INTELLIGENCE_PROVIDER=mock
LLMFORGE_INTELLIGENCE_MODEL=gemini-1.5-flash

# Web UI Settings
LLMFORGE_HOST=127.0.0.1
LLMFORGE_PORT=8080

# Target Local Model Settings
LLMFORGE_LOCAL_MODEL_TYPE=subprocess
LLMFORGE_LOCAL_MODEL_COMMAND=python3 -m tests.fixtures.dummy_model
LLMFORGE_LOCAL_MODEL_ENDPOINT=http://127.0.0.1:11434

# Pipeline & Storage Settings
LLMFORGE_STORAGE_DIR=runs
